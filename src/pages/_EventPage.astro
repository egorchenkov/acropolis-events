---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { render } from 'astro:content';
import { t, localizedPath, type Lang } from '../i18n';

interface Props {
  event: any;
  lang: Lang;
}

const { event, lang } = Astro.props;
const { data } = event;
const { Content } = await render(event);

const isOwn = data.eventType === 'own';
const hasSpeakers = data.speakers && data.speakers.length > 0;
const hasProgram = data.program && data.program.length > 0;
const hasPhotos = data.photos && data.photos.length > 0;
const hasConclusions = data.conclusions && data.conclusions.length > 0;
const hasRecommendations = data.recommendations && (data.recommendations.immediate?.length || data.recommendations.strategic?.length);
const hasTechStack = data.techStack && data.techStack.length > 0;

const navLinks = [];
if (hasSpeakers) navLinks.push({ label: t(lang, 'event.speakers'), href: '#speakers' });
if (hasPhotos) navLinks.push({ label: t(lang, 'event.gallery'), href: '#gallery' });
if (hasConclusions) navLinks.push({ label: t(lang, 'event.conclusions'), href: '#conclusions' });
if (hasRecommendations) navLinks.push({ label: t(lang, 'event.recommendations'), href: '#recommendations' });

const firstPhoto = hasPhotos ? data.photos![0] : undefined;
---

<BaseLayout
  title={`${data.title} — ACROPOLIS INTEGRO Events`}
  description={data.description}
  ogImage={firstPhoto}
  dateISO={data.dateISO}
  endDateISO={data.endDateISO}
  location={data.location}
  locationAddress={data.locationAddress}
  speakers={data.speakers}
  navLinks={navLinks}
  lang={lang}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge">
        {data.eventType === 'own' ? t(lang, 'event.badgeOwn') : t(lang, 'event.badgeParticipation')}
      </div>
      <h1>{data.title}</h1>
      {data.subtitle && (
        <p class="hero-subtitle">{data.subtitle}</p>
      )}
      <div class="hero-meta">
        <span class="hero-meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {data.date}
        </span>
        <span class="hero-meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {data.location}
        </span>
      </div>
      <div class="hero-partners">
        {data.partners.map((p: any) => (
          p.url ? (
            <a href={p.url} target="_blank" rel="noopener" class="hero-partner" title={p.name}>
              {p.logo && <img src={p.logo} alt={p.name} class="hero-partner-logo" />}
              {!p.logo && p.name}
            </a>
          ) : (
            <span class="hero-partner">
              {p.logo && <img src={p.logo} alt={p.name} class="hero-partner-logo" />}
              {!p.logo && p.name}
            </span>
          )
        ))}
      </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 80V40C240 0 480 0 720 40C960 80 1200 80 1440 40V80H0Z" fill="white"/>
    </svg>
  </section>

  <!-- Back to list -->
  <div class="container" style="padding-top: 2rem;">
    <a href={localizedPath(lang, '/')} class="back-link reveal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      {t(lang, 'event.backToList')}
    </a>
  </div>

  <!-- Content / Description -->
  <section class="section">
    <div class="container">
      <div class="reveal" style="max-width: 800px; margin: 0 auto; font-size: 1.1rem; line-height: 1.7; color: var(--gray-700);">
        <Content />
      </div>
    </div>
  </section>

  <!-- Program -->
  <!-- Program (hidden when speakers section is present to avoid duplication) -->
  {hasProgram && !hasSpeakers && (
    <section class="section section-light" id="program">
      <div class="container">
        <div class="section-header reveal">
          <h2>{t(lang, 'event.program')}</h2>
        </div>
        <div class="program-list" style="max-width: 800px; margin: 0 auto;">
          {data.program!.map((item: any) => (
            <div class="program-item reveal">
              <div class="program-time">{item.time}</div>
              <div>
                <div class="program-title">{item.title}</div>
                {item.speaker && <div class="program-speaker">{item.speaker}</div>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Speakers -->
  {hasSpeakers && (
    <section class="section" id="speakers">
      <div class="container">
        <div class="section-header reveal">
          <h2>{t(lang, 'event.speakers')}</h2>
        </div>
        <div class="speakers-list">
          {data.speakers!.map((speaker: any, i: number) => (
            <SpeakerCard
              name={speaker.name}
              company={speaker.company}
              role={speaker.role}
              topic={speaker.topic}
              details={speaker.details}
              photo={speaker.photo}
              index={i}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Photo Gallery -->
  {hasPhotos && (
    <PhotoGallery photos={data.photos!} lang={lang} />
  )}

  <!-- Conclusions -->
  {hasConclusions && (
    <section class="section section-dark" id="conclusions">
      <div class="container">
        <div class="section-header reveal">
          <h2>{t(lang, 'event.conclusions')}</h2>
        </div>
        <div class="pillars-grid">
          {data.conclusions!.map((pillar: any, i: number) => (
            <div class={`pillar-card reveal reveal-delay-${Math.min(i + 1, 3)}`}>
              <div class="pillar-title">{pillar.title}</div>
              <div class="pillar-items">
                {pillar.items.map((item: string) => (
                  <div class="pillar-item">{item}</div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Recommendations -->
  {hasRecommendations && (
    <section class="section" id="recommendations">
      <div class="container">
        <div class="section-header reveal">
          <h2>{t(lang, 'event.recommendations')}</h2>
        </div>
        <div class="actions-grid">
          {data.recommendations!.immediate && data.recommendations!.immediate.length > 0 && (
            <div class="action-block reveal">
              <h3>{t(lang, 'event.immediateActions')}</h3>
              <div class="action-list">
                {data.recommendations!.immediate.map((item: string, i: number) => (
                  <div class="action-item">
                    <span class="action-number">{i + 1}</span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
          {data.recommendations!.strategic && data.recommendations!.strategic.length > 0 && (
            <div class="action-block reveal reveal-delay-1">
              <h3>{t(lang, 'event.strategicInitiatives')}</h3>
              <div class="action-list">
                {data.recommendations!.strategic.map((item: string, i: number) => (
                  <div class="action-item">
                    <span class="action-number">{i + 1}</span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {hasTechStack && (
          <>
            <div class="section-header reveal" style="margin-top: 3rem;">
              <h3>{t(lang, 'event.techStack')}</h3>
            </div>
            <div class="tech-stack-row">
              {data.techStack!.map((tech: any) => (
                <div class={`tech-card reveal${tech.color ? ` tc-${tech.color}` : ''}`}>
                  <div class="tech-card-name">{tech.name}</div>
                  <div class="tech-card-desc">{tech.description}</div>
                </div>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )}

  <!-- CTA / Contact -->
  <section class="cta-section" id="contact">
    <div class="container cta-inner">
      <h2 class="reveal">{data.ctaQuestion || (isOwn ? t(lang, 'event.ctaDefault') : t(lang, 'event.ctaContact'))}</h2>
      <p class="reveal reveal-delay-1">
        {t(lang, 'event.ctaSubtitle')}
      </p>
      <div class="cta-buttons reveal reveal-delay-2">
        {data.contact?.telegram && (
          <a href={data.contact.telegram} target="_blank" rel="noopener" class="btn btn-primary">
            {t(lang, 'event.writeTelegram')}
          </a>
        )}
        {data.contact?.email && (
          <a href={`mailto:${data.contact.email}`} class="btn btn-outline">
            {data.contact.email}
          </a>
        )}
      </div>
      <div class="cta-contacts reveal reveal-delay-3">
        {data.contact?.phone && (
          <span class="cta-contact-item">
            <a href={`tel:${data.contact.phone.replace(/\s/g, '')}`}>{data.contact.phone}</a>
          </span>
        )}
        {data.contact?.website && (
          <span class="cta-contact-item">
            <a href={`https://${data.contact.website}`} target="_blank" rel="noopener">{data.contact.website}</a>
          </span>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
