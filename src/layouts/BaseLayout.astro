---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  dateISO?: string;
  endDateISO?: string;
  location?: string;
  locationAddress?: string;
  speakers?: Array<{ name: string; company?: string; role?: string }>;
  navLinks?: { label: string; href: string }[];
  isHomePage?: boolean;
  lang: Lang;
}

const { title, description, ogImage, canonicalUrl, dateISO, endDateISO, location, locationAddress, speakers, navLinks, isHomePage, lang } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#3129B1" />
  <SEO
    title={title}
    description={description}
    ogImage={ogImage}
    canonicalUrl={canonicalUrl}
    dateISO={dateISO}
    endDateISO={endDateISO}
    location={location}
    locationAddress={locationAddress}
    speakers={speakers}
    isHomePage={isHomePage}
    lang={lang}
  />
</head>
<body>
  <Header navLinks={navLinks} lang={lang} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />

  <!-- Intersection Observer for reveal animations -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => {
      observer.observe(el);
    });
  </script>
</body>
</html>
