---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  dateISO?: string;
  location?: string;
  locationAddress?: string;
  isHomePage?: boolean;
}

const { title, description, ogImage, canonicalUrl, dateISO, location, locationAddress, isHomePage } = Astro.props;

const siteUrl = 'https://events.acropolis.uz';
const fullUrl = canonicalUrl || siteUrl + Astro.url.pathname;
const fullOgImage = ogImage ? (ogImage.startsWith('http') ? ogImage : siteUrl + ogImage) : undefined;

// Get events for ItemList schema on homepage
let eventsForSchema: { id: string; data: { title: string; description: string } }[] = [];
if (isHomePage) {
  const allEvents = await getCollection('events');
  eventsForSchema = allEvents.sort((a, b) => b.data.dateISO.localeCompare(a.data.dateISO));
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="IT мероприятия Узбекистан, инфраструктурный клуб, Acropolis Integro, IT конференции Ташкент, бизнес-ужины IT, Commvault, SUSE, Juniper, центр обработки данных, кибербезопасность" />
<meta name="author" content="Acropolis Integro" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={fullUrl} />

{isHomePage && (
  <>
    <meta name="geo.region" content="UZ" />
    <meta name="geo.placename" content="Tashkent" />
    <meta name="language" content="Russian" />
    <meta name="revisit-after" content="7 days" />
    <meta name="rating" content="general" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://t.me" />
  </>
)}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={fullUrl} />
{fullOgImage && <meta property="og:image" content={fullOgImage} />}
<meta property="og:site_name" content="ACROPOLIS INTEGRO Events" />
<meta property="og:locale" content="ru_RU" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{fullOgImage && <meta name="twitter:image" content={fullOgImage} />}

<!-- JSON-LD -->
{isHomePage && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Acropolis Integro",
    "url": "https://acropolis.uz",
    "logo": "https://events.acropolis.uz/images/logo-color.svg",
    "description": "Системный интегратор и IT-дистрибьютор в Центральной Азии. Организатор инфраструктурного клуба для IT-профессионалов.",
    "sameAs": [
      "https://t.me/acropolis_integro"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@acropolis.uz",
      "contactType": "customer service"
    }
  })} />
)}
{isHomePage && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ACROPOLIS INTEGRO Events",
    "url": "https://events.acropolis.uz",
    "description": description,
    "publisher": {
      "@type": "Organization",
      "name": "Acropolis Integro"
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://events.acropolis.uz/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
)}
{isHomePage && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": "https://events.acropolis.uz"
    }]
  })} />
)}
{isHomePage && eventsForSchema.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Мероприятия ACROPOLIS INTEGRO",
    "description": "Список IT мероприятий инфраструктурного клуба ACROPOLIS",
    "numberOfItems": eventsForSchema.length,
    "itemListElement": eventsForSchema.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `${siteUrl}/${event.id}/`,
      "name": event.data.title
    }))
  })} />
)}
{dateISO && location && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": title.replace(' — ACROPOLIS INTEGRO Events', ''),
    "startDate": dateISO,
    "location": {
      "@type": "Place",
      "name": location,
      ...(locationAddress ? { address: locationAddress } : {}),
    },
    "organizer": {
      "@type": "Organization",
      "name": "Acropolis Integro",
      "url": "https://acropolis.uz",
    },
    "description": description,
  })} />
)}
