---
import { getCollection } from 'astro:content';
import { t, getAlternateUrls, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  dateISO?: string;
  location?: string;
  locationAddress?: string;
  isHomePage?: boolean;
  lang: Lang;
}

const { title, description, ogImage, canonicalUrl, dateISO, location, locationAddress, isHomePage, lang } = Astro.props;

const siteUrl = 'https://events.acropolis.uz';
const fullUrl = canonicalUrl || siteUrl + Astro.url.pathname;
const fullOgImage = ogImage ? (ogImage.startsWith('http') ? ogImage : siteUrl + ogImage) : undefined;
const alternates = getAlternateUrls(Astro.url);

// Get events for ItemList schema on homepage
let eventsForSchema: { id: string; data: { title: string; description: string } }[] = [];
if (isHomePage) {
  const allEvents = await getCollection('events', (e) => e.id.startsWith(`${lang}/`));
  eventsForSchema = allEvents.sort((a, b) => b.data.dateISO.localeCompare(a.data.dateISO));
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={t(lang, 'seo.keywords')} />
<meta name="author" content="Acropolis Integro" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={fullUrl} />

<!-- hreflang -->
<link rel="alternate" hreflang="ru" href={siteUrl + alternates.ru} />
<link rel="alternate" hreflang="en" href={siteUrl + alternates.en} />
<link rel="alternate" hreflang="uz" href={siteUrl + alternates.uz} />
<link rel="alternate" hreflang="x-default" href={siteUrl + alternates.ru} />

{isHomePage && (
  <>
    <meta name="geo.region" content="UZ" />
    <meta name="geo.placename" content="Tashkent" />
    <meta name="language" content={t(lang, 'seo.language')} />
    <meta name="revisit-after" content="7 days" />
    <meta name="rating" content="general" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://t.me" />
  </>
)}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={fullUrl} />
{fullOgImage && <meta property="og:image" content={fullOgImage} />}
<meta property="og:site_name" content="ACROPOLIS INTEGRO Events" />
<meta property="og:locale" content={t(lang, 'seo.ogLocale')} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{fullOgImage && <meta name="twitter:image" content={fullOgImage} />}

<!-- JSON-LD -->
{isHomePage && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Acropolis Integro",
    "url": "https://acropolis.uz",
    "logo": "https://events.acropolis.uz/images/logo-color.svg",
    "description": t(lang, 'seo.orgDescription'),
    "sameAs": [
      "https://t.me/acropolis_integro"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@acropolis.uz",
      "contactType": "customer service"
    }
  })} />
)}
{isHomePage && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ACROPOLIS INTEGRO Events",
    "url": "https://events.acropolis.uz",
    "description": description,
    "publisher": {
      "@type": "Organization",
      "name": "Acropolis Integro"
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://events.acropolis.uz/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
)}
{isHomePage && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
      "@type": "ListItem",
      "position": 1,
      "name": t(lang, 'seo.breadcrumbHome'),
      "item": "https://events.acropolis.uz"
    }]
  })} />
)}
{isHomePage && eventsForSchema.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": t(lang, 'seo.itemListName'),
    "description": t(lang, 'seo.itemListDescription'),
    "numberOfItems": eventsForSchema.length,
    "itemListElement": eventsForSchema.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `${siteUrl}/${event.id.replace(`${lang}/`, '')}/`,
      "name": event.data.title
    }))
  })} />
)}
{dateISO && location && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": title.replace(' — ACROPOLIS INTEGRO Events', '').replace(' — ACROPOLIS INTEGRO', ''),
    "startDate": dateISO,
    "location": {
      "@type": "Place",
      "name": location,
      ...(locationAddress ? { address: locationAddress } : {}),
    },
    "organizer": {
      "@type": "Organization",
      "name": "Acropolis Integro",
      "url": "https://acropolis.uz",
    },
    "description": description,
  })} />
)}
