---
import { languages, type Lang, getAlternateUrls } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternateUrls = getAlternateUrls(Astro.url);
const otherLangs = (Object.keys(languages) as Lang[]).filter(l => l !== lang);
---

<div class="lang-switcher">
  <button class="lang-switcher-btn" aria-label="Change language">
    {lang.toUpperCase()}
  </button>
  <div class="lang-switcher-dropdown">
    {otherLangs.map((l) => (
      <a href={alternateUrls[l]} class="lang-switcher-option">
        {l.toUpperCase()}
      </a>
    ))}
  </div>
</div>

<style>
  .lang-switcher {
    position: relative;
    margin-left: 1rem;
  }

  .lang-switcher-btn {
    background: #ffffff;
    color: #3129b1;
    border: none;
    border-radius: 30px;
    padding: 0.35rem 0.9rem;
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-family);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: box-shadow 0.2s;
  }

  .lang-switcher-btn:hover {
    box-shadow: 0 2px 8px rgba(49, 41, 177, 0.15);
  }

  .lang-switcher-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    min-width: 48px;
    z-index: 200;
  }

  .lang-switcher-dropdown::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }

  .lang-switcher:hover .lang-switcher-dropdown,
  .lang-switcher:focus-within .lang-switcher-dropdown {
    display: block;
  }

  .lang-switcher-option {
    display: block;
    padding: 0.5rem 0.9rem;
    font-size: 11px;
    font-weight: 700;
    color: #3129b1;
    text-decoration: none;
    text-align: center;
    transition: background 0.15s;
  }

  .lang-switcher-option:hover {
    background: #f0f0ff;
  }

  @media (max-width: 960px) {
    .lang-switcher {
      position: absolute;
      right: 6rem;
      top: 50%;
      transform: translateY(-50%);
    }
  }
</style>
